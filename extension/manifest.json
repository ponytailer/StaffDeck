{
  "manifest_version": 3,
  "name": "StaffDeck 浏览器助手",
  "version": "0.1.0",
  "description": "把 StaffDeck 数字员工装进每一个网页：登录后即可与免费员工、模型员工和小队随时对话。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://ai-staff.folidaymall.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
